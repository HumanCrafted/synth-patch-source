  "engine": {
    "kind": "blocks",
    "blocks": [
      {
        "id": "keys",
        "type": "keyboard"
      },
      {
        "id": "clock",
        "type": "clock",
        "params": {
          "bpm": {
            "control": "Tempo",
            "turns": {
              "base": 120,
              "perTurn": 40,
              "min": 30,
              "max": 300
            }
          }
        }
      },
      {
        "id": "trigger",
        "type": "gate-or",
        "params": {
          "useB": {
            "control": "Hold"
          }
        },
        "inputs": {
          "a": "keys.gate",
          "b": "clock.out"
        }
      },
      {
        "id": "env",
        "type": "decay-env",
        "params": {
          "decay": {
            "control": "Filter Envelope Decay",
            "range": [
              0.05,
              8
            ],
            "curve": "exp"
          }
        },
        "inputs": {
          "gate": {
            "jack": "Gate Input",
            "normal": "trigger.out"
          }
        },
        "outputs": {
          "out": "Envelope Output"
        }
      },
      {
        "id": "vco",
        "type": "vco",
        "params": {
          "octave": {
            "control": "Oscillator Range",
            "steps": {
              "32'": -2,
              "16'": -1,
              "8'": 0,
              "4'": 1
            }
          },
          "tune": {
            "control": "Oscillator Pitch",
            "range": [
              -12,
              12
            ]
          },
          "wave": {
            "control": "Oscillator Wave",
            "steps": {
              "Saw": 0,
              "Triangle": 1,
              "Square": 2
            }
          },
          "pulseWidth": {
            "control": "Oscillator Pulse Width",
            "range": [
              0.5,
              0.95
            ]
          }
        },
        "inputs": {
          "pitch": "keys.pitch",
          "pitchCv": {
            "jack": "Pitch CV Input"
          }
        },
        "outputs": {
          "out": "Oscillator Output"
        }
      },
      {
        "id": "vcf",
        "type": "ladder",
        "params": {
          "cutoff": {
            "control": "Filter Cutoff",
            "range": [
              20,
              20480
            ],
            "curve": "exp"
          },
          "resonance": {
            "control": "Filter Resonance",
            "range": [
              0,
              1.05
            ]
          },
          "envAmount": {
            "control": "Filter Envelope Amount",
            "range": [
              -6,
              6
            ]
          },
          "keyTrack": 1,
          "cvAmount": 1
        },
        "inputs": {
          "in": "vco.out",
          "pitch": "keys.pitch",
          "env": "env.out",
          "cutoffCv": {
            "jack": "Cutoff CV Input"
          }
        }
      },
      {
        "id": "vca",
        "type": "vca",
        "inputs": {
          "in": "vcf.out",
          "cv": "env.out"
        },
        "outputs": {
          "out": "Main Output"
        }
      }
    ],
    "leds": {
      "Clock Indicator": {
        "source": "clock.out",
        "on": "On",
        "off": "Off"
      }
    },
    "output": "vca.out"
  }
